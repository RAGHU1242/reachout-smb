# ==============================================
# ReachOut SMB - Environment Configuration
# ==============================================

# Database Configuration (PostgreSQL / Supabase or SQLite for local)
DATABASE_URL=sqlite+aiosqlite:///./reachout.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Configuration (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ENVIRONMENT=development

# Meta Platform (Instagram & WhatsApp - Meta Graph API v26.0)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

# Instagram Messaging API
INSTAGRAM_VERIFY_TOKEN=reachout_instagram_verify_token_2026
INSTAGRAM_APP_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=reachout_whatsapp_verify_token_2026
WHATSAPP_APP_SECRET=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock Mode Flags (set to true for standalone offline testing)
MOCK_AI=true
MOCK_INSTAGRAM=true
MOCK_WHATSAPP=true
MOCK_PAYMENTS=true

# Security
JWT_SECRET=reachout-smb-secure-jwt-secret-key-development-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
